rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Perfil do usuário
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Registro de nomes de usuário únicos
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Placar de líderes / Ranking global
    match /rankings/{rankingId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Partidas do Modo Duelo Online (criadas por código de 6 dígitos ou públicas)
    match /duels/{duelId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Feedback e sugestões dos jogadores
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if true;
    }
  }
}
